# ==========================================
# CRAWLABLE SPECIFIC DIRECTORIES & FILES
# ==========================================
# Output directory containing the AI-filtered extractions (defined in src/config.py)
Crawlable_output/

# Temporary directory created during the GitHub OTA zip update (main.py)
.ota_update_tmp/

# Log file generated by the Linux/macOS bootstrapper (Start_Crawlable.sh)
boot_diagnostics.log

# ==========================================
# PYTHON & VIRTUAL ENVIRONMENTS
# ==========================================
# Virtual environments (main.py initializes .venv automatically)
.venv/
venv/
env/
ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# ==========================================
# SECRETS & CONFIGURATION
# ==========================================
# Strongly protect environment variables (prevents leaking GEMINI_API_KEY)
.env
.env.local
.env.*.local

# ==========================================
# IDEs & OS SPECIFIC
# ==========================================
# VS Code
.vscode/
*.code-workspace

# IntelliJ / PyCharm
.idea/
*.iml

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini